# Copy this to deploy/.env and fill it in. Rig refuses to start if anything
# required is missing, and says which setting it is.
#
#   cp deploy/.env.example deploy/.env
#
# Generate the two secrets with:
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -base64 32   # ENV_ENCRYPTION_KEY

# ---------------------------------------------------------------- domain
# Apps get <name>.BASE_DOMAIN, so `hello` becomes hello.tobipi.dev.
BASE_DOMAIN=tobipi.dev
# Where the dashboard lives. Defaults to rig.<BASE_DOMAIN>.
RIG_HOSTNAME=rig.tobipi.dev
# Hostnames the domain already uses, comma separated, so no app can take them.
EXTRA_RESERVED_NAMES=
# Domains Rig refuses to attach to an app, because they are something else.
GUARDED_DOMAINS=tobiolajide.com,oluwatobiolajide.com,madebytobi.com,tobiwashere.com

# ---------------------------------------------------------------- secrets
# At least 32 characters. Changing it signs everyone out.
SESSION_SECRET=
# Exactly 32 bytes as base64 or hex. Encrypts app environment values at rest.
# Changing it makes existing environment values unreadable, so keep a copy.
ENV_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- your account
OWNER_EMAIL=you@example.com
# Set this once so the first boot creates the account, then remove it and manage
# the password with:  docker compose exec rig node dist/cli.js create-owner
OWNER_PASSWORD=

# ---------------------------------------------------------------- cloudflare
# From Cloudflare Zero Trust, Networks, Tunnels. Treat it like a password.
TUNNEL_TOKEN=

# ---------------------------------------------------------------- optional
# The image CI publishes, which follows the repository name. Change it only
# if you build your own.
RIG_IMAGE=ghcr.io/tobibytes/deploy-hub:latest
# Traefik's port on the host, only used for testing on the local network.
TRAEFIK_HTTP_PORT=8080
POSTGRES_USER=rig
POSTGRES_DB=rig
# Set to false only if you reach the dashboard over plain http.
COOKIE_SECURE=true
LOG_LEVEL=info
