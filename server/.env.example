# Server Configuration
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/deployhub

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Admin Configuration
# Comma-separated list of admin email addresses
# Example: ADMIN_ACCOUNTS=admin@example.com,user@admin.com
ADMIN_ACCOUNTS=

# Cloudflare Tunnel (Optional)
ENABLE_PUBLIC_URL=false

# Default User (for backward compatibility)
DEPLOY_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
