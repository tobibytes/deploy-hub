# Database Configuration (PostgreSQL - Neon, Railway, etc.)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Backend Configuration
PORT=3001
NODE_ENV=development

# Default user ID (no auth system configured; all operations use this user)
DEPLOY_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
VITE_DEPLOY_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Frontend URL Configuration
VITE_BACKEND_URL=http://localhost:3001
