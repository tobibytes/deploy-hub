{
  "name": "rig",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "pnpm --filter @rig/api dev",
    "dev:web": "pnpm --filter @rig/web dev",
    "build": "pnpm --filter @rig/shared build && pnpm --filter @rig/web build && pnpm --filter @rig/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "infra:up": "./scripts/infra.sh up",
    "infra:down": "./scripts/infra.sh down",
    "smoke": "./scripts/smoke.sh",
    "create-owner": "pnpm --filter @rig/api create-owner"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  }
}
